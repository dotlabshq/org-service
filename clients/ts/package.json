{
  "name": "@baseworks/org",
  "version": "2.0.0",
  "description": "Org capability: typed HTTP client, event catalog, projections, and CLI plugin for org-service. Contract-first, versioned with the service.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./dist/client.js",
    "./events": "./dist/events.js",
    "./projections": "./dist/projections.js",
    "./cli": "./dist/cli.js",
    "./hono": "./dist/hono.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@baseworks/cli": "^0.2.0",
    "@baseworks/foldbase": "workspace:*",
    "commander": "^15.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@baseworks/tsconfig": "workspace:*",
    "@types/node": "^22.20.0",
    "msw": "^2.14.6",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9",
    "hono": "^4.12.27"
  },
  "peerDependencies": {
    "hono": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    }
  }
}
