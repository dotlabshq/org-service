PORT=3006
FOLDBASE_URL=http://127.0.0.1:3400
FOLDBASE_TENANT=platform

# Realm token verification. JWT_SECRET is the legacy HS256 path, accepted while
# it is set; a realm on ES256 sets AUTH_JWKS_URI instead (plus AUTH_ISSUER and
# AUTH_AUDIENCE in production).
JWT_SECRET=dev-secret-change-me-32-chars-min
# AUTH_JWKS_URI=http://127.0.0.1:3003/.well-known/jwks.json
# AUTH_ISSUER=http://localhost:8080
# AUTH_AUDIENCE=baseworks-local

# iam-service. Optional, and two things depend on it:
#   GET /orgs/:ref/members  joins in each member's email and name
#   GET /invitations        needs the caller's email, which a realm token
#                           deliberately does not carry
# Without it, members list without names, and the invitee endpoints answer
# 409 email_unavailable rather than an empty list — "you have no invitations"
# would be a lie when the truth is "this service cannot tell".
IAM_SERVICE_URL=http://127.0.0.1:3007

# Services allowed to write memberships acting as themselves. Empty means none.
# ORG_MEMBERSHIP_WRITERS=zone9-api
